# QualiOS local development environment — EXAMPLE ONLY.
# Copy to .env and fill in real values. Never commit a real .env.
# No real secrets are stored in this repo.

# PostgreSQL connection for apps/api and packages/db
DATABASE_URL=postgres://qualios:qualios@localhost:5432/qualios_dev

# API
API_PORT=3001
API_HOST=127.0.0.1

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Auth (managed provider — NOT selected yet, see ADR-011)
# AUTH_ISSUER_URL=
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=

# Object storage (S3-compatible — NOT configured yet, see ADR-005)
# S3_ENDPOINT=
# S3_BUCKET=qualios-documents-dev
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# AI provider (abstraction — NOT selected yet, see ADR-007)
# AI_PROVIDER=
# AI_API_KEY=
